<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 결제 알림이 이번 달 할 일과 맞을 때 알리려고 (Android 13+ 는 사용자가 허용해야 한다, 카드 알림 화면에서 묻는다) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 로그인 크롬 맞춤 탭을 찾으려고 (Android 11+ 패키지 공개 범위) -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OurMoney">

        <!-- 웹앱을 담는 첫 화면. 로그인에서 돌아오는 ourmoney://auth-callback 도 여기로 (singleTask: 로그인 탭을 닫고 같은 화면으로) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ourmoney" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- 카드 알림 모으기 화면: 앱 안에서만 연다 -->
        <activity
            android:name=".notice.NoticeActivity"
            android:exported="false" />

        <!-- 일정 내보내기(.ics)를 공유 창으로 넘길 때만: 캐시의 exports/ 폴더 한 곳, 다른 앱은 직접 못 열고 넘겨받은 파일 읽기만 잠깐 허락 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 결제 알림 맞춤 폰 알림의 [체크하기]·[아니에요]: 이 앱의 PendingIntent 만 부른다 -->
        <receiver
            android:name=".notice.MatchActionReceiver"
            android:exported="false" />

        <!-- 카드 결제 알림 읽기: 시스템(BIND_NOTIFICATION_LISTENER_SERVICE 를 가진 쪽)만 붙을 수 있다 -->
        <service
            android:name=".notice.CardNoticeListener"
            android:exported="true"
            android:label="@string/notice_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
